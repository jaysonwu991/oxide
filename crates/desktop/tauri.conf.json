{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxide",
  "version": "0.0.0",
  "identifier": "dev.oxide.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Oxide",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Native Rust AI coding agent",
    "longDescription": "Oxide desktop manages multiple projects and sessions, sharing the same configuration and session store as the Oxide CLI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  }
}
