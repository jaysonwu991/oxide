{
  "name": "oxide-vscode",
  "displayName": "Oxide",
  "description": "The Oxide coding agent inside VS Code: a chat panel and editor actions backed by the oxide CLI.",
  "version": "0.0.0",
  "publisher": "jaysonwu991",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaysonwu991/oxide.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/jaysonwu991/oxide",
  "bugs": {
    "url": "https://github.com/jaysonwu991/oxide/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "oxide",
    "agent",
    "ai",
    "coding agent",
    "cli",
    "chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:oxide.chat",
    "onView:oxide.chatSecondary"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Oxide runs a coding agent that reads and writes files in your workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oxide",
          "title": "Oxide",
          "icon": "media/oxide.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "oxide-secondary",
          "title": "Oxide",
          "icon": "media/oxide.svg"
        }
      ]
    },
    "views": {
      "oxide": [
        {
          "type": "webview",
          "id": "oxide.chat",
          "name": "Chat",
          "icon": "media/oxide.svg",
          "contextualTitle": "Oxide"
        }
      ],
      "oxide-secondary": [
        {
          "type": "webview",
          "id": "oxide.chatSecondary",
          "name": "Chat",
          "icon": "media/oxide.svg",
          "contextualTitle": "Oxide"
        }
      ]
    },
    "commands": [
      {
        "command": "oxide.openChat",
        "title": "Open Chat",
        "category": "Oxide"
      },
      {
        "command": "oxide.newSession",
        "title": "New Session",
        "category": "Oxide",
        "icon": "$(add)"
      },
      {
        "command": "oxide.resumeSession",
        "title": "Resume Session...",
        "category": "Oxide",
        "icon": "$(history)"
      },
      {
        "command": "oxide.continueSession",
        "title": "Continue Last Session",
        "category": "Oxide"
      },
      {
        "command": "oxide.stop",
        "title": "Stop",
        "category": "Oxide",
        "icon": "$(debug-stop)"
      },
      {
        "command": "oxide.addToChat",
        "title": "Add File or Selection to Chat",
        "category": "Oxide"
      },
      {
        "command": "oxide.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Oxide"
      },
      {
        "command": "oxide.explainSelection",
        "title": "Explain Selection",
        "category": "Oxide"
      },
      {
        "command": "oxide.fixSelection",
        "title": "Fix Selection",
        "category": "Oxide"
      },
      {
        "command": "oxide.reviewChanges",
        "title": "Review Working Tree Changes",
        "category": "Oxide"
      },
      {
        "command": "oxide.openTerminal",
        "title": "Open Terminal (TUI)",
        "category": "Oxide",
        "icon": "$(terminal)"
      },
      {
        "command": "oxide.showOutput",
        "title": "Show Output Channel",
        "category": "Oxide"
      },
      {
        "command": "oxide.setModel",
        "title": "Set Model...",
        "category": "Oxide"
      },
      {
        "command": "oxide.setAgent",
        "title": "Set Agent...",
        "category": "Oxide"
      },
      {
        "command": "oxide.setReasoning",
        "title": "Set Reasoning Effort...",
        "category": "Oxide"
      },
      {
        "command": "oxide.setProjectTrust",
        "title": "Set Project Trust...",
        "category": "Oxide"
      },
      {
        "command": "oxide.mcpServers",
        "title": "MCP Servers...",
        "category": "Oxide",
        "icon": "$(server-process)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "oxide.askAboutSelection",
          "when": "editorHasSelection",
          "group": "oxide@1"
        },
        {
          "command": "oxide.explainSelection",
          "when": "editorHasSelection",
          "group": "oxide@2"
        },
        {
          "command": "oxide.fixSelection",
          "when": "editorHasSelection",
          "group": "oxide@3"
        },
        {
          "command": "oxide.addToChat",
          "when": "editorHasSelection",
          "group": "oxide@4"
        }
      ],
      "explorer/context": [
        {
          "command": "oxide.addToChat",
          "group": "oxide@1"
        }
      ],
      "commandPalette": [
        {
          "command": "oxide.stop",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "oxide.newSession",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "oxide.resumeSession",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@2"
        },
        {
          "command": "oxide.openTerminal",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "oxide.openChat",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "oxide.addToChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Oxide",
      "properties": {
        "oxide.binaryPath": {
          "type": "string",
          "default": "oxide",
          "description": "Path to the oxide binary. A bare name is looked up on PATH, then in ~/.local/bin and ~/.cargo/bin."
        },
        "oxide.model": {
          "type": "string",
          "default": "",
          "description": "Model passed with --model. Leave empty to use the model from the Oxide config.json."
        },
        "oxide.agent": {
          "type": "string",
          "default": "",
          "description": "Agent passed with --agent, loaded from the workspace's .oxide/agents (or .claude/agents)."
        },
        "oxide.reasoning": {
          "type": "string",
          "enum": [
            "auto",
            "off",
            "low",
            "medium",
            "high"
          ],
          "default": "auto",
          "description": "Reasoning effort passed with --reasoning."
        },
        "oxide.projectTrust": {
          "type": "string",
          "enum": [
            "default",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Use the decision saved in trust.json, or defaultProjectTrust.",
            "Pass --approve: load this workspace's .oxide agents, commands, skills, plugins and hooks.",
            "Pass --no-approve: ignore this workspace's project-local resources."
          ],
          "default": "default",
          "markdownDescription": "Project trust for the workspace's own resources (`.oxide/agents`, `.oxide/commands`, `.oxide/skills`, `.oxide/plugins`, `SYSTEM.md`, and the Claude Code equivalents). Runs are non-interactive, so nothing is ever prompted."
        },
        "oxide.tools": {
          "type": "string",
          "default": "",
          "description": "Comma-separated tool allowlist passed with --tools (e.g. read,grep,find,ls for a read-only run)."
        },
        "oxide.excludeTools": {
          "type": "string",
          "default": "",
          "description": "Comma-separated tool denylist passed with --exclude-tools."
        },
        "oxide.additionalArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to every oxide invocation."
        },
        "oxide.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show the model's reasoning in the transcript as a collapsible block."
        },
        "oxide.askApprovals": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before running a tool a permission rule gates (`--ask-approvals`). The question appears in the transcript and the turn waits for it; **Always allow** is remembered per project in the shared `approvals.json`, so the terminal and the desktop app honour it too. Turn this off to run gated tools without a prompt (`--no-ask-approvals`). Either way the flag is passed explicitly, so this setting — not `askApprovals` in the shared `settings.json` — decides for a run started from the panel."
        },
        "oxide.notifyOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a run finishes while the chat view is hidden."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "check": "tsc -p . --noEmit",
    "test": "pnpm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package"
  },
  "packageManager": "pnpm@11.23.0",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
