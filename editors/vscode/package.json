{
  "name": "oxide-vscode",
  "displayName": "Oxide",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "jaysonwu991",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaysonwu991/oxide.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/jaysonwu991/oxide",
  "bugs": {
    "url": "https://github.com/jaysonwu991/oxide/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "oxide",
    "agent",
    "ai",
    "coding agent",
    "cli",
    "chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%extension.workspaceTrust%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oxide",
          "title": "Oxide",
          "icon": "media/oxide.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "oxide-secondary",
          "title": "Oxide",
          "icon": "media/oxide.svg"
        }
      ]
    },
    "views": {
      "oxide": [
        {
          "type": "webview",
          "id": "oxide.chat",
          "name": "%extension.view.chat%",
          "icon": "media/oxide.svg",
          "contextualTitle": "Oxide"
        }
      ],
      "oxide-secondary": [
        {
          "type": "webview",
          "id": "oxide.chatSecondary",
          "name": "%extension.view.chat%",
          "icon": "media/oxide.svg",
          "contextualTitle": "Oxide"
        }
      ]
    },
    "commands": [
      {
        "command": "oxide.openChat",
        "title": "%extension.command.openChat%",
        "category": "Oxide",
        "icon": "media/oxide.svg"
      },
      {
        "command": "oxide.focusInput",
        "title": "%extension.command.focusInput%",
        "category": "Oxide"
      },
      {
        "command": "oxide.insertReference",
        "title": "%extension.command.insertReference%",
        "category": "Oxide"
      },
      {
        "command": "oxide.newSession",
        "title": "%extension.command.newSession%",
        "category": "Oxide",
        "icon": "$(add)"
      },
      {
        "command": "oxide.resumeSession",
        "title": "%extension.command.resumeSession%",
        "category": "Oxide",
        "icon": "$(history)"
      },
      {
        "command": "oxide.continueSession",
        "title": "%extension.command.continueSession%",
        "category": "Oxide"
      },
      {
        "command": "oxide.stop",
        "title": "%extension.command.stop%",
        "category": "Oxide",
        "icon": "$(debug-stop)"
      },
      {
        "command": "oxide.addToChat",
        "title": "%extension.command.addToChat%",
        "category": "Oxide"
      },
      {
        "command": "oxide.askAboutSelection",
        "title": "%extension.command.askAboutSelection%",
        "category": "Oxide"
      },
      {
        "command": "oxide.explainSelection",
        "title": "%extension.command.explainSelection%",
        "category": "Oxide"
      },
      {
        "command": "oxide.fixSelection",
        "title": "%extension.command.fixSelection%",
        "category": "Oxide"
      },
      {
        "command": "oxide.reviewChanges",
        "title": "%extension.command.reviewChanges%",
        "category": "Oxide"
      },
      {
        "command": "oxide.openTerminal",
        "title": "%extension.command.openTerminal%",
        "category": "Oxide",
        "icon": "$(terminal)"
      },
      {
        "command": "oxide.showOutput",
        "title": "%extension.command.showOutput%",
        "category": "Oxide"
      },
      {
        "command": "oxide.setModel",
        "title": "%extension.command.setModel%",
        "category": "Oxide"
      },
      {
        "command": "oxide.setAgent",
        "title": "%extension.command.setAgent%",
        "category": "Oxide"
      },
      {
        "command": "oxide.setReasoning",
        "title": "%extension.command.setReasoning%",
        "category": "Oxide"
      },
      {
        "command": "oxide.setProjectTrust",
        "title": "%extension.command.setProjectTrust%",
        "category": "Oxide"
      },
      {
        "command": "oxide.connectProvider",
        "title": "%extension.command.connectProvider%",
        "category": "Oxide",
        "icon": "$(plug)"
      },
      {
        "command": "oxide.mcpServers",
        "title": "%extension.command.mcpServers%",
        "category": "Oxide",
        "icon": "$(server-process)"
      },
      {
        "command": "oxide.worktrees",
        "title": "%extension.command.worktrees%",
        "category": "Oxide",
        "icon": "$(git-branch)"
      },
      {
        "command": "oxide.language",
        "title": "%extension.command.language%",
        "category": "Oxide",
        "icon": "$(globe)"
      },
      {
        "command": "oxide.checkForUpdates",
        "title": "%extension.command.checkForUpdates%",
        "category": "Oxide",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "oxide.openChat",
          "when": "resourceScheme == file",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "oxide.askAboutSelection",
          "when": "editorHasSelection",
          "group": "oxide@1"
        },
        {
          "command": "oxide.explainSelection",
          "when": "editorHasSelection",
          "group": "oxide@2"
        },
        {
          "command": "oxide.fixSelection",
          "when": "editorHasSelection",
          "group": "oxide@3"
        },
        {
          "command": "oxide.addToChat",
          "when": "editorHasSelection",
          "group": "oxide@4"
        }
      ],
      "explorer/context": [
        {
          "command": "oxide.addToChat",
          "group": "oxide@1"
        }
      ],
      "commandPalette": [
        {
          "command": "oxide.stop",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "oxide.newSession",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "oxide.resumeSession",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@2"
        },
        {
          "command": "oxide.openTerminal",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@3"
        },
        {
          "command": "oxide.checkForUpdates",
          "when": "view == oxide.chat || view == oxide.chatSecondary",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "oxide.openChat",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "oxide.addToChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      },
      {
        "command": "oxide.focusInput",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "oxide.insertReference",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Oxide",
      "properties": {
        "oxide.binaryPath": {
          "type": "string",
          "default": "oxide",
          "description": "%extension.setting.binaryPath%"
        },
        "oxide.model": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Choose a model in Oxide. The choice is saved in the shared config.json for CLI, Desktop and VS Code.",
          "description": "%extension.setting.model%"
        },
        "oxide.agent": {
          "type": "string",
          "default": "",
          "description": "%extension.setting.agent%"
        },
        "oxide.reasoning": {
          "type": "string",
          "enum": [
            "auto",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "auto",
          "deprecationMessage": "Choose a reasoning level in Oxide. The choice is shared with CLI and Desktop.",
          "description": "%extension.setting.reasoning%"
        },
        "oxide.projectTrust": {
          "type": "string",
          "enum": [
            "default",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%extension.setting.projectTrust.default%",
            "%extension.setting.projectTrust.always%",
            "%extension.setting.projectTrust.never%"
          ],
          "default": "default",
          "markdownDescription": "%extension.setting.projectTrust%"
        },
        "oxide.tools": {
          "type": "string",
          "default": "",
          "description": "%extension.setting.tools%"
        },
        "oxide.excludeTools": {
          "type": "string",
          "default": "",
          "description": "%extension.setting.excludeTools%"
        },
        "oxide.additionalArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%extension.setting.additionalArguments%"
        },
        "oxide.followUpBehavior": {
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "enumItemLabels": [
            "Queue",
            "Steer"
          ],
          "markdownEnumDescriptions": [
            "Wait for the active response to finish, then send the follow-up as the next turn.",
            "Apply the follow-up to the active response."
          ],
          "default": "queue",
          "description": "%extension.setting.followUpBehavior%"
        },
        "oxide.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "%extension.setting.showThinking%"
        },
        "oxide.autoContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%extension.setting.autoContext%"
        },
        "oxide.askApprovals": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%extension.setting.askApprovals%"
        },
        "oxide.notifyOnFinish": {
          "type": "boolean",
          "default": true,
          "description": "%extension.setting.notifyOnFinish%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node ../../scripts/prepare-diagrams.mjs vscode && tsc -p .",
    "watch": "node ../../scripts/prepare-diagrams.mjs vscode && tsc -p . -w",
    "check": "tsc -p . --noEmit",
    "test": "pnpm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.2.1",
    "mermaid": "12.2.0",
    "typescript": "^5.6.3"
  }
}
